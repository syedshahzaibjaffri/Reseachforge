# ==============================================================================
# ResearchForge AI — Environment Configuration
# ==============================================================================

# GEMINI_API_KEY: Required for live Google Gemini AI synthesis and web grounding.
# Automatically injected in AI Studio from user secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# OPTIONAL MODULAR RESEARCH PROVIDER KEYS:
# ResearchForge includes built-in verified benchmark datasets and operates gracefully
# if any of these are not configured.
# ACADEMIC_SEARCH_API_KEY="" # Semantic Scholar / CrossRef / Core API
# NEWS_SEARCH_API_KEY=""     # NewsAPI / GDelft
# GOV_DATA_API_KEY=""        # Data.gov / NIST NVD
